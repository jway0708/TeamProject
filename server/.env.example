# Copy to server/.env. Never commit the populated file.
HOST=127.0.0.1
PORT=3000
# Set true behind HTTPS in production.
SECURE_COOKIES=false
LOYALTY_API_BASE_URL=https://xcodeappapi.xcode.com.my/api
LOYALTY_USERNAME=
LOYALTY_PASSWORD=
# Alternatively supply a valid token. A fixed token cannot auto-refresh.
LOYALTY_API_TOKEN=
